#!/usr/bin/env bash
set -euo pipefail

# Guard against accidental API keys or tokens being committed to the repo.
# This is intentionally simple and fast; it's a preventive stop-gap, not a full secret-scanning suite.
if git diff --cached --name-only --diff-filter=ACM | grep -q .; then
  matches=$(git diff --cached --unified=0 -- . \
    | grep '^+' \
    | grep -v '^+++' \
    | grep -nE 'sk-ant-[A-Za-z0-9_-]{20,}|sk-or-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|AKIA[0-9A-Z]{16}|aws_secret_access_key[[:space:]]*[:=][[:space:]]*[A-Za-z0-9/+=]{20,}|BEGIN [A-Z ]*PRIVATE KEY' || true)

  if [ -n "$matches" ]; then
    echo "Potential secret detected in staged changes:" >&2
    echo "$matches" >&2
    echo "Remove the key or move it to backend/.env (gitignored) before committing." >&2
    exit 1
  fi
fi
