# Copy this file to backend/.env and fill in your own values — never commit the real
# .env file, and never paste a real key into this .example file either. The backend
# loads .env automatically on startup (via python-dotenv) — no manual `export` needed.
# See README.md section 6 for the full walkthrough.

# --- LLM-assisted SOAP notes (optional) ---
# Use ONE of the two options below. If both are set, ANTHROPIC_API_KEY is tried first.

# Option A: direct Anthropic API — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional — override the default Claude model used via the direct API.
# Check https://docs.claude.com/en/docs/about-claude/models/overview for current IDs.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option B: OpenRouter (routes to an LLM via an OpenAI-compatible API) —
# get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional — override the default model(s) tried via OpenRouter. Comma-separated list;
# each is tried in order until one succeeds. Check https://openrouter.ai/models for
# current free-tier availability, since free slugs rotate/expire without notice.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Live speech recognition (multilingual auto-detect: English/Urdu/mixed) ---
# Use a MULTILINGUAL model: "base" is the fast CPU default, "small" is more
# accurate but slower and heavier to download. Do NOT use ".en"-suffixed models
# (e.g. base.en) — they are English-only and the backend rejects them, and they
# cannot transcribe Urdu.
WHISPER_MODEL=base

# --- LiveKit Cloud audio transport ---
# Create a new key/secret in LiveKit Cloud. Never expose the secret to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional real speaker diarization ---
# Requires pyannote.audio + torch (see requirements.txt) and a Hugging Face token.
# Accept the license on https://huggingface.co/pyannote/speaker-diarization-3.1
# first, then put the token below. The backend reads HF_TOKEN first and falls
# back to HUGGINGFACE_TOKEN. Diarization is best-effort: if anything fails at
# finalize time the transcript simply keeps the live heuristic speaker labels.
HF_TOKEN=
# HUGGINGFACE_TOKEN=

# --- Security defaults ---
# Optional API key for protecting non-public routes when the app is exposed beyond a
# single local machine. The backend checks the X-API-Key header on protected endpoints.
CLINICAL_SCRIBE_API_KEY=

# --- Security note ---
# If a real key is ever accidentally pasted into any file (including this one) and
# that file is shared or committed, treat the key as compromised and regenerate it
# immediately from the provider's dashboard — do not just delete it from the file.
