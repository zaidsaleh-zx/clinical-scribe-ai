# Copy this file to backend/.env and fill in your own values — never commit the real
# .env file. The backend loads it automatically on startup (via python-dotenv) — no
# manual `export` needed. See README.md section 6 for the full walkthrough.

# --- LLM-assisted SOAP notes (optional) ---
# Use ONE of the two options below. If both are set, ANTHROPIC_API_KEY is tried first.

# Option A: direct Anthropic API — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B: OpenRouter (routes to Claude via an OpenAI-compatible API) —
# get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional — override the default Claude model used via OpenRouter
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# --- Live English speech recognition ---
# base.en is the fast CPU default. Use small.en for better accent accuracy if
# the machine can tolerate more processing time and a larger model download.
WHISPER_MODEL=base.en

# --- LiveKit Cloud audio transport (OPTIONAL — Live Audio works without it) ---
# Live Audio streams the mic directly to the backend over the WebSocket and uses the
# local faster-whisper model, so it works with NO LiveKit account. Only fill these in
# if you want the optional cloud transport path. Create a new key/secret in LiveKit
# Cloud. Never expose the secret to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional real speaker diarization ---
# Requires pyannote.audio and a Hugging Face token with access to the diarization
# model. Keep disabled until that dependency and token are configured.
DIARIZATION_ENABLED=false
HUGGINGFACE_TOKEN=
